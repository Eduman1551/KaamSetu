{
  "name": "kaamsetu",
  "version": "1.0.0",
  "private": true,
  "description": "KaamSetu (SkillBridge) — resume insights from real job listings",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.9.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "tsc --noEmit",
    "compress-bg": "tsx scripts/compress-bg.ts",
    "sample-resume": "tsx scripts/make-sample-resume.ts",
    "db:push": "drizzle-kit push",
    "db:studio": "drizzle-kit studio",
    "test": "vitest run",
    "db:reset": "tsx --env-file=.env.local scripts/db-reset.ts",
    "db:seed:demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "seed:sample": "tsx --env-file=.env.local scripts/seed-sample.ts"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.2.1",
    "@sparticuz/chromium": "153.0.0",
    "bcryptjs": "^3.0.3",
    "drizzle-orm": "~0.45.4",
    "formidable": "^3.5.4",
    "framer-motion": "^12.43.0",
    "groq-sdk": "^1.6.0",
    "lucide-react": "^1.77.0",
    "next": "15.5.29",
    "next-auth": "~4.24.15",
    "pdf-parse": "1.1.1",
    "playwright": "^1.65.1",
    "playwright-core": "1.65.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^2.15.4",
    "swr": "^2.5.1",
    "ws": "^8.23.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/formidable": "^3.5.1",
    "@types/node": "^26.6.6",
    "@types/pdf-parse": "^1.1.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/ws": "^8.18.2",
    "autoprefixer": "^10.7.0",
    "drizzle-kit": "~0.31.11",
    "postcss": "^8.5.33",
    "sharp": "^0.35.5",
    "tailwindcss": "^3.4.19",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^3.2.7"
  }
}
